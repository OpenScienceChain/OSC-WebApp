{
  "name": "osc-web-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:staging": "ng serve --configuration=staging",
    "build": "ng build",
    "build:production": "ng build --configuration=production",
    "build:staging": "ng build --configuration=staging",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr": "npm run build:ssr && npm run serve:ssr:OSC-WebApp",
    "dev:ssr": "ng serve --configuration=ssr",
    "build:ssr": "ng build --configuration=production,ssr",
    "serve:ssr:OSC-WebApp": "node dist/osc-web-app/server/server.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss}\" \"cypress/**/*.ts\"",
    "duplication:check": "jscpd --config .jscpd.json --baseline .jscpd-baseline.json --fail-on-new-clones 0 --fail-on-empty src server.ts",
    "duplication:baseline": "jscpd --config .jscpd.json --baseline .jscpd-baseline.json --update-baseline --fail-on-empty src server.ts",
    "lint": "eslint \"src/**/*.ts\" \"cypress/**/*.ts\"",
    "test:ci": "ng test --no-watch --browsers=ChromeHeadless --code-coverage",
    "cypress:open": "cypress open",
    "cypress:open:session": "cypress open --browser chrome",
    "cypress:run": "cypress run",
    "test:a11y:run": "cypress run --browser chrome --spec cypress/e2e/accessibility/accessibility.cy.ts",
    "test:a11y": "playwright test",
    "test:a11y:cypress": "start-server-and-test \"npm start -- --host 127.0.0.1\" http://127.0.0.1:4200 test:a11y:run",
    "cypress:open:staging": "cypress open --env USE_STAGING_API=true",
    "cypress:run:staging": "cypress run --env USE_STAGING_API=true",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.33",
    "@angular/cdk": "20.2.14",
    "@angular/common": "20.3.33",
    "@angular/compiler": "20.3.33",
    "@angular/core": "20.3.33",
    "@angular/forms": "20.3.33",
    "@angular/platform-browser": "20.3.33",
    "@angular/platform-browser-dynamic": "20.3.33",
    "@angular/platform-server": "20.3.33",
    "@angular/router": "20.3.33",
    "@ng-bootstrap/ng-bootstrap": "19.0.1",
    "@ngx-translate/core": "^16.0.4",
    "@ngx-translate/http-loader": "^16.0.1",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "crypto-js": "^4.2.0",
    "express": "4.22.2",
    "jszip": "^3.10.1",
    "ngx-toastr": "^19.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.37",
    "@angular/cli": "20.3.37",
    "@angular/compiler-cli": "20.3.33",
    "@angular/ssr": "20.3.37",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "axe-core": "^4.12.1",
    "cypress": "16.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.0.0",
    "jasmine-core": "~5.2.0",
    "jscpd": "5.2.1",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "start-server-and-test": "^2.1.5",
    "typescript": "5.9.3",
    "vite": "^6.1.1"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,html,css,scss}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
